import pdfplumber
import os

# Update this to match your actual resume's file name!
file_name = "RESUME.pdf" 
file_path = f"uploads/RESUME.pdf"

# It's always good practice to check if the file exists first
if os.path.exists(file_path):
    print(f"Found {file_name}! Extracting text...\n")
    
    with pdfplumber.open(file_path) as pdf:
        text = ""
        for page in pdf.pages:
            # Extract text from each page and add a new line
            extracted = page.extract_text()
            if extracted: # Just in case a page is empty/scanned
                text += extracted + "\n"
                
    print("-" * 40)
    print("First 500 characters of your resume:")
    print("-" * 40)
    print(text[:500]) 
    
else:
    print(f"Error: Could not find '{file_name}' in the uploads folder.")
    print("Check your spelling and folder structure!")


def analyze_resume_text(resume_text):
    # 1. Clean the text (make it lowercase to make searching easier)
    text_lower = resume_text.lower()
    
    # 2. Define our rules and keywords
    standard_sections = ['experience', 'education', 'skills', 'projects', 'summary']
    action_verbs = ['developed', 'managed', 'created', 'led', 'designed', 'optimized']
    
    # 3. Analyze the Content & ATS (Checking for standard sections)
    found_sections = [sec for sec in standard_sections if sec in text_lower]
    ats_score = len(found_sections) * 20  # 20 points per section found, max 100
    
    # 4. Analyze Keywords (Checking for action verbs)
    found_verbs = [verb for verb in action_verbs if verb in text_lower]
    keyword_score = min(len(found_verbs) * 15, 100) # 15 points per verb, cap at 100
    
    # 5. Calculate Overall Score
    overall_score = int((ats_score + keyword_score) / 2)
    
    # 6. Generate Suggestions based on missing elements
    suggestions = []
    if 'summary' not in found_sections:
        suggestions.append("Add a Professional Summary at the top of your resume.")
    if len(found_verbs) < 3:
        suggestions.append("Use more strong action verbs (e.g., 'developed', 'led', 'optimized').")
        
    if not suggestions:
        suggestions.append("Great job! Your resume hits the standard benchmarks.")

    # 7. Package it up exactly how your JavaScript frontend expects it
    return {
        "score": overall_score,
        "sections": {
            "content": {"score": 85, "feedback": "Content looks solid, but could use more quantified metrics."},
            "formatting": {"score": 90, "feedback": "Text was easily readable by the parser."},
            "keywords": {"score": keyword_score, "feedback": f"Found {len(found_verbs)} strong action verbs."},
            "ats": {"score": ats_score, "feedback": f"Found {len(found_sections)} out of 5 standard sections."}
        },
        "suggestions": suggestions
    }

# Run the text from your previous cell through our new brain!
# (Assuming the variable from your last cell was named 'text')
results = analyze_resume_text(text)

print(f"Overall Score: {results['score']}")
print(f"Suggestions: {results['suggestions']}")
print("\nFull JSON Payload:")
import json
print(json.dumps(results, indent=2))


import requests
import json
import os
from dotenv import load_dotenv

# 1. Load the hidden variables from your .env file
# (override=True forces it to read the file fresh just in case Jupyter is being stubborn)
load_dotenv(override=True)

# 2. Grab the key securely
NVIDIA_API_KEY = os.getenv("NVIDIA_API_KEY")

# Safety check
if not NVIDIA_API_KEY:
    raise ValueError("API Key not found! Check your .env file and make sure it is named exactly .env")

invoke_url = "https://integrate.api.nvidia.com/v1/chat/completions"

headers = {
  "Authorization": f"Bearer {NVIDIA_API_KEY}",
  "Accept": "application/json" 
}

# 3. Give the AI instructions and the text
prompt = f"""
You are an expert ATS system and recruiter. Analyze the following resume text.
Return ONLY a valid JSON object matching this exact structure:
{{
  "score": 85,
  "sections": {{
    "content": {{"score": 90, "feedback": "..."}},
    "formatting": {{"score": 80, "feedback": "..."}},
    "keywords": {{"score": 75, "feedback": "..."}},
    "ats": {{"score": 95, "feedback": "..."}}
  }},
  "suggestions": [
    "Suggestion 1",
    "Suggestion 2"
  ]
}}

Resume Text:
{text}
"""

payload = {
  "model": "google/gemma-4-31b-it",
  "messages": [{"role": "user", "content": prompt}],
  "max_tokens": 1024,
  "temperature": 0.2, 
  "top_p": 0.95,
  "stream": False,    
}

print("Sending resume to NVIDIA API...")

# 4. Make the call to NVIDIA
response = requests.post(invoke_url, headers=headers, json=payload)

if response.status_code == 200:
    # Dig into the NVIDIA response object to get just the text the AI generated
    ai_response_text = response.json()['choices'][0]['message']['content']
    
    # Strip away any markdown formatting the AI might add (like ```json ... ```)
    clean_json_string = ai_response_text.strip('```json').strip('```').strip()
    
    # Convert the string into a real Python dictionary
    final_results = json.loads(clean_json_string)
    
    print("\nSuccess! Here is your AI analysis:\n")
    print(json.dumps(final_results, indent=2))
else:
    print(f"Error {response.status_code}: {response.text}")


